<Window x:Class="BlackJack_WPF1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlackJack" Height="720" Width="1280"
        ResizeMode="NoResize">

    <Grid x:Name="grid" Margin="20">

        <Grid.Background>
            <ImageBrush ImageSource="/BlackjackTable.webp" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>


        <Label Content="You" Grid.Row="0" Grid.Column="0" 
               FontSize="36" FontFamily="Britannic Bold" Foreground="White"
               HorizontalAlignment="Center">
        </Label>

        <Label Content="Dealer" Grid.Row="0" Grid.Column="1"
               FontSize="36" FontFamily="Britannic Bold" Foreground="White"
               HorizontalAlignment="Center">
        </Label>

          
        <Label x:Name="du" Grid.Row="1" Grid.Column="0" 
               FontSize="86" HorizontalAlignment="Center" VerticalAlignment="Center"
               FontFamily="Showcard Gothic">
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF80FFE8"/>
                    <GradientStop Color="#FF01493C" Offset="1"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>

        <Label x:Name="geg" Grid.Row="1" Grid.Column="1" 
               FontSize="86" HorizontalAlignment="Center" VerticalAlignment="Center"
               FontFamily="Showcard Gothic">
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFF9898"/>
                    <GradientStop Color="#FF7D0000" Offset="1"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>


        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,350,0,0">


            <Button x:Name="zieh" Click="zieh_click" Content="Hit"
                    Width="221" Height="78" Margin="10,0"
                    FontFamily="Impact" FontSize="48" Foreground="White">
                <Button.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#FF2C6F64" Offset="1"/>
                        <GradientStop Color="#FF00AD91"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>


            <Button x:Name="passen" Click="passen_Click" Content="Stand"
                    Width="221" Height="78"
                    FontFamily="Impact" FontSize="48" Foreground="White">
                <Button.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#FF2000"/>
                        <GradientStop Color="#FF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

        </StackPanel>


        <Button x:Name="reset" Click="reset_click" Content="Reset"
                FontFamily="Candara" FontSize="18" Foreground="IndianRed" Grid.Column="1" HorizontalAlignment="Right"
                Margin="0,42,42,547" Width="110" RenderTransformOrigin="0.555,0.635" Grid.RowSpan="2">
            <Button.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#FFFFC3C3"/>
                    <GradientStop Color="#FF8C8C8C" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="exit" Click="exit_click" Content="Exit"
                    FontFamily="Candara" FontSize="18"
                    Foreground="#FF03473B" BorderBrush="#FF7B3030" Margin="42,42,468,547" Grid.RowSpan="2">
            <Button.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#FFB9F7ED"/>
                    <GradientStop Color="#FFABA6A6" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>

    </Grid>
</Window>
